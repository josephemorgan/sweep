# Copy to .env (repo root). Server code loads it from the root regardless of cwd.

# Postgres from `docker compose up -d postgres`
DATABASE_URL=postgres://sweep:sweep@localhost:5432/sweep

# Better Auth (wired in session C). Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-32-plus-random-characters
# Origin users load the app from; the only origin allowed to make state-changing requests.
# Dev: http://localhost:4200 (ng serve proxies /api to the server). Production: the public https origin
# (with NODE_ENV=production the server refuses to start on http, except on a loopback origin).
BETTER_AUTH_URL=http://localhost:4200

# docker compose only: BETTER_AUTH_URL inside the app container (default http://localhost:3000).
# Separate so the dev value above never leaks into the container.
# SWEEP_APP_URL=http://localhost:3000

# Reverse-proxy hops to trust for client IPs (rate limits). Unset = trust none.
# TRUST_PROXY=1

# Time budget in ms for parsing one uploaded guide in its worker thread (spec §6.4). Default 5000.
# PARSE_TIMEOUT_MS=5000

# Public sign-up stays off unless explicitly enabled (spec §6).
SIGNUP_ENABLED=false

# Demo mode: adds a "Try the demo" button to the sign-in page. Guests share one demo account and
# get sample playthroughs kept in memory per session; nothing a guest does is saved, and it is
# gone when the session ends or the server restarts. Default false.
# DEMO_ENABLED=false

# Express port
PORT=3000
