# Copy to .env (repo root). Server code loads it from the root regardless of cwd.

# Postgres from `docker compose up -d postgres`
DATABASE_URL=postgres://sweep:sweep@localhost:5432/sweep

# Better Auth (wired in session C). Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-32-plus-random-characters
# Origin users load the app from. In dev, ng serve on 4200 proxies /api to the server.
BETTER_AUTH_URL=http://localhost:4200

# Public sign-up stays off unless explicitly enabled (spec §6).
SIGNUP_ENABLED=false

# Express port
PORT=3000
