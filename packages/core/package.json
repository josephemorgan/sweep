{
  "name": "@sweep/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./parse": {
      "types": "./dist/parse/index.d.ts",
      "default": "./dist/parse/index.js"
    }
  },
  "bin": {
    "sweep": "./bin/sweep.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.lib.json && tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "typescript": "~6.0.3",
    "vitest": "5.0.2"
  }
}
