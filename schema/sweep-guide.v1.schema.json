{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sweep guide v1",
  "description": "A Sweep guide file. See docs/guide-format.md.",
  "type": "object",
  "properties": {
    "sweep": {
      "type": "number",
      "const": 1
    },
    "game": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "categories": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "about": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "tracked": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "about"
        ],
        "additionalProperties": false
      }
    },
    "sections": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "category": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
          },
          "windows": {
            "minItems": 1,
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string",
                  "maxLength": 64,
                  "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
                },
                "until": {
                  "type": "string",
                  "maxLength": 64,
                  "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
                },
                "home": {
                  "type": "string",
                  "maxLength": 64,
                  "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
                }
              },
              "required": [
                "from"
              ],
              "additionalProperties": false
            }
          },
          "how": {
            "type": "string",
            "maxLength": 10000
          },
          "exclusive": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
          },
          "spoiler": {
            "type": "boolean"
          },
          "renamed_from": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
              },
              {
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 64,
                  "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
                }
              }
            ]
          }
        },
        "required": [
          "id",
          "title",
          "category",
          "windows"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "sweep",
    "game",
    "sections"
  ],
  "additionalProperties": false,
  "$defs": {
    "section": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "overview": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "walkthrough": {
          "type": "string",
          "maxLength": 100000
        },
        "requires": {
          "anyOf": [
            {
              "maxItems": 50,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
              }
            },
            {
              "type": "object",
              "properties": {
                "any": {
                  "maxItems": 50,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 64,
                    "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
                  }
                }
              },
              "required": [
                "any"
              ],
              "additionalProperties": false
            }
          ]
        },
        "spoiler": {
          "type": "boolean"
        },
        "renamed_from": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
            },
            {
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
              }
            }
          ]
        },
        "sections": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/section"
          }
        }
      },
      "required": [
        "id",
        "title",
        "overview"
      ],
      "additionalProperties": false
    }
  }
}
